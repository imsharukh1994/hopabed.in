PORT=4000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hopebed?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=hopebed

R2_ACCOUNT_ID=your-account-id
R2_BUCKET_NAME=hopebed-media
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_PUBLIC_URL=https://your-public-bucket-url.r2.dev
R2_REGION=auto

CORS_ORIGIN=http://localhost:3000
