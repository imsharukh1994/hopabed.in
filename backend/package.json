{
  "name": "hopebed-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "test:auth": "cross-env NODE_ENV=test JWT_SECRET=01234567890123456789012345678901 MONGODB_URI=mongodb://127.0.0.1:27017/hopebed MONGODB_DB_NAME=hopebed node --import tsx --test src/middleware/auth.test.ts",
    "seed:navi-mumbai": "tsx src/scripts/seedNaviMumbai.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.31.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
